PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.kh0jaqe.mongodb.net/portfolio
FRONTEND_ORIGIN=https://mattiagiuliani.vercel.app
NODE_ENV=production
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=choose_a_strong_password
JWT_SECRET=generate_at_generate-secret.vercel.app/64
PUBLIC_SITE_URL=https://your-portfolio.vercel.app
# Set false only for local admin diagnostics against a shared database.
PUBLICATION_WORKER_ENABLED=true
FRONTEND_REVALIDATE_URL=https://your-portfolio.vercel.app/api/internal/revalidate
REVALIDATION_SECRET=use-the-same-long-random-secret-configured-on-vercel
PUBLICATION_POLL_MS=15000
PUBLICATION_REQUEST_TIMEOUT_MS=10000

# Backend-only media storage. Separate namespaces for development/staging/production.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MEDIA_NAMESPACE=portfolio/production
# 3 MiB input AND normalized output; raise only after testing deployed proxy limits.
# Accepted range: 1024..8388608 bytes. Never a promise that the hosting proxy supports 8 MiB.
MEDIA_MAX_BYTES=3145728
MEDIA_PROVIDER_TIMEOUT_MS=15000
